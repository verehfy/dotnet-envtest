<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Kubernetes.EnvTest</RootNamespace>
    <Description>A .NET port of controller-runtime's envtest: starts a local Kubernetes control plane (etcd + kube-apiserver) for integration testing, with CRD and webhook installation, certificate generation, and binary provisioning compatible with setup-envtest.</Description>
    <PackageTags>kubernetes;envtest;testing;controller-runtime;operator;crd;webhook</PackageTags>
    <!-- Required by the LibraryImport source generator (P/Invoke of libc kill for Unix SIGTERM). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KubernetesClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Kubernetes.EnvTest.Provisioning/Kubernetes.EnvTest.Provisioning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kubernetes.EnvTest.Tests" />
  </ItemGroup>

</Project>
